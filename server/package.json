{
  "name": "score-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scanned PDF -> OMR -> MusicXML -> structured score -> alignment API for pairing bars and notes with timestamps in an audio recording.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js",
    "engines:probe": "node src/omr/probe-cli.js",
    "demo:check": "node scripts/demo-check.mjs",
    "convert": "node scripts/convert.mjs",
    "osmd:check": "node scripts/osmd-check.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.6.0"
  }
}
